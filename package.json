{
  "name": "playwright-pom-framework",
  "version": "1.0.0",
  "description": "Page Object Model Playwright framework with API, UI, and DB validation support",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:headed": "playwright test --headed",
    "test:chrome": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:serial": "playwright test --workers=1",
    "test:report": "playwright show-report",
    "lint": "eslint src/**/*.ts",
    "build": "tsc",
    "clean": "rm -rf dist results"
  },
  "keywords": [
    "playwright",
    "page-object-model",
    "typescript",
    "testing",
    "e2e",
    "api",
    "database"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "eslint": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "dotenv": "^16.0.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "pg": "^8.11.0",
    "mysql2": "^3.6.0",
    "sqlite3": "^5.1.0",
    "winston": "^3.11.0"
  }
}
